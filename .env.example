HTTP_ADDR=:8080

# Same Postgres the scraper writes to.
# SQLAlchemy-style URLs are accepted and normalized for Go:
#   postgresql+psycopg2://user:pass@host:5432/dbname
# or native:
#   postgres://user:pass@host:5432/dbname
# Encode @ in password as %40 (abc@2026 -> abc%402026)
# From Docker on same host use host.docker.internal (see DEPLOY.md)
DATABASE_URL=postgres://yt_user:abc%402026@host.docker.internal:5432/yt_videos?sslmode=disable

# Comma-separated API keys (required). Generate long random values.
API_KEYS=change-me-long-random-key

# Optional CORS allowlist (empty = no browser origins allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Requests per minute per IP+key
RATE_LIMIT_RPM=120

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# Safety cap when using limit=all / all=true
MAX_ALL_PAGE_SIZE=5000

# Only return transfer-ready / playable content
READY_ONLY=true
